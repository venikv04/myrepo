create or replace  temporary view AIRBNB.silver.silver_hosts__dbt_tmp
  
  
  
  
  as (
    
    
SELECT 
    HOST_ID,
    REPLACE(HOST_NAME, ' ', '') AS HOST_NAME,
    HOST_SINCE AS HOST_SINCE,
    IS_SUPERHOST AS IS_SUPERHOST,
    RESPONSE_RATE AS RESPONSE_RATE,
    CASE 
    WHEN RESPONSE_RATE < 95 THEN 'VERY GOOD'
    WHEN RESPONSE_RATE < 80 THEN 'GOOD'
    WHEN RESPONSE_RATE < 60 THEN 'FAIR'
    ELSE 'POOR'
    END AS RESPONSE_RATE_QUALITY,
    CREATED_AT AS CREATED_AT
FROM AIRBNB.bronze.bronze_hosts
  )
