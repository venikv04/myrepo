18:00:17.727052 [debug]: Query executed on node model.aws_dbt_snowflake_project.silver_listings:
create or replace  temporary view AIRBNB.silver.silver_listings__dbt_tmp
  
  
  
  
  as (
    

SELECT
    HOST_ID AS HOST_ID,
    LISTING_ID, 
    PROPERTY_TYPE,
    ROOM_TYPE,
    CITY,
    COUNTRY,
    ACCOMMODATES,
    BEDROOMS,
    BATHROOMS,
    PRICE_PER_NIGHT,
    
    CASE 
    WHEN price_per_night < 100 THEN 'low'
    WHEN price_per_night < 200 THEN 'medium'
    ELSE 'high'
    END
 AS PRICE_PER_NIGHT_TAG,
    CREATED_AT
    FROM AIRBNB.bronze.bronze_listings
    
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.aws_dbt_snowflake_project.silver_listings", "profile_name": "aws_dbt_snowflake_project", "target_name": "dev"} */
18:00:17.736753 [debug]: Query executed on node model.aws_dbt_snowflake_project.silver_hosts:
create or replace  temporary view AIRBNB.silver.silver_hosts__dbt_tmp
  
  
  
  
  as (
    
    
SELECT 
    HOST_ID,
    REPLACE(HOST_NAME, ' ', '') AS HOST_NAME,
    HOST_SINCE AS HOST_SINCE,
    IS_SUPERHOST AS IS_SUPERHOST,
    RESPONSE_RATE AS RESPONSE_RATE,
    CASE 
    WHEN RESPONSE_RATE < 95 THEN 'VERY GOOD'
    WHEN RESPONSE_RATE < 80 THEN 'GOOD'
    WHEN RESPONSE_RATE < 60 THEN 'FAIR'
    ELSE 'POOR'
    END AS RESPONSE_RATE_QUALITY,
    CREATED_AT AS CREATED_AT
FROM AIRBNB.bronze.bronze_hosts
  )
