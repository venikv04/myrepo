create or replace  temporary view AIRBNB.silver.silver_listings__dbt_tmp
  
  
  
  
  as (
    

SELECT 
    LISTING_ID,
    HOST_ID,
    PROPERTY_TYPE,
    ROOM_TYPE,
    CITY,
    COUNTRY,
    ACCOMMODATES,
    BEDROOMS,
    BATHROOMS,
    PRICE_PER_NIGHT,
    
    CASE 
    WHEN price_per_night < 100 THEN 'low'
    WHEN price_per_night < 200 THEN 'medium'
    ELSE 'high'
    END
 AS PRICE_PER_NIGHT_TAG,
    CREATED_AT
    FROM AIRBNB.bronze.bronze_listings
    
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.aws_dbt_snowflake_project.silver_listings", "profile_name": "aws_dbt_snowflake_project", "target_name": "dev"} */
16:34:47.256482 [debug]: Query executed on node model.aws_dbt_snowflake_project.silver_bookings:
create or replace  temporary view AIRBNB.silver.silver_bookings__dbt_tmp
  
  
  
  
  as (
    

SELECT 
    BOOKING_ID, 
    LISTING_ID,
    BOOKING_DATE,
    
   round( NIGHTS_BOOKED * BOOKING_AMOUNT , 2)
 + CLEANING_FEE + SERVICE_FEE AS TOTAL_BOOKING_AMOUNT,
    BOOKING_STATUS, 
    CREATED_AT
FROM AIRBNB.bronze.bronze_bookings
  )
