create or replace transient  table AIRBNB.silver.silver_listings
    
    
    
    as (

SELECT 
    LISTING_ID,
    PROPERTY_TYPE,
    ROOM_TYPE,
    CITY,
    COUNTRY,
    ACCOMMODATES,
    BEDROOMS,
    BATHROOMS,
    PRICE_PER_NIGHT,
    
    CASE 
    WHEN price_per_night < 100 THEN 'low'
    WHEN price_per_night < 200 THEN 'medium'
    ELSE 'high'
    END
 AS PRICE_PER_NIGHT_TAG,
    CREATED_AT
    FROM AIRBNB.bronze.bronze_listings
    
    )

