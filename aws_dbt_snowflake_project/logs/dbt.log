/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.aws_dbt_snowflake_project.silver_listings", "profile_name": "aws_dbt_snowflake_project", "target_name": "dev"} */
17:55:55.553763 [debug]: Query executed on node model.aws_dbt_snowflake_project.silver_hosts:
create or replace  temporary view AIRBNB.silver.silver_hosts__dbt_tmp
  
  
  
  
  as (
    
    
SELECT 
    HOST_ID,
    REPLACE(HOST_NAME, ' ', '') AS HOST_NAME,
    HOST_SINCE AS HOST_SINCE,
    IS_SUPERHOST AS IS_SUPERHOST,
    RESPONSE_RATE AS RESPONSE_RATE,
    CASE 
    WHEN RESPONSE_RATE < 95 THEN 'VERY GOOD'
    WHEN RESPONSE_RATE < 80 THEN 'GOOD'
    WHEN RESPONSE_RATE < 60 THEN 'FAIR'
    ELSE 'POOR'
    END AS RESPONSE_RATE_QUALITY,
    CREATED_AT AS CREATED_AT
FROM AIRBNB.bronze.bronze_hosts
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.aws_dbt_snowflake_project.silver_hosts", "profile_name": "aws_dbt_snowflake_project", "target_name": "dev"} */
17:55:55.603568 [debug]: Query executed on node model.aws_dbt_snowflake_project.silver_bookings:
create or replace  temporary view AIRBNB.silver.silver_bookings__dbt_tmp
  
  
  
  
  as (
    

SELECT 
    BOOKING_ID, 
    LISTING_ID,
    BOOKING_DATE,
    
   round( NIGHTS_BOOKED * BOOKING_AMOUNT , 2)
 + CLEANING_FEE + SERVICE_FEE AS TOTAL_BOOKING_AMOUNT,
