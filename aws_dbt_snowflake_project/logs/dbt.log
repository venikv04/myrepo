create or replace  temporary view AIRBNB.silver.silver_listings__dbt_tmp
  
  
  
  
  as (
    

SELECT
    LISTING_ID,
    HOST_ID, 
    PROPERTY_TYPE,
    ROOM_TYPE,
    CITY,
    COUNTRY,
    ACCOMMODATES,
    BEDROOMS,
