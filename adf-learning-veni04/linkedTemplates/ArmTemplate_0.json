							"isSequential": false,
							"activities": [
								{
									"name": "EXC_SQL_INCREMENTAL_PIPELINE",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "Childpipeline_incremental",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
